# Raza Shoe Palace — Frontend Environment Configuration

# Backend API base URL (Leave empty in local dev to use Vite proxy; Set in production for Vercel)
# Example for Vercel: VITE_API_URL=https://your-raza-backend.onrender.com
VITE_API_URL=

# Razorpay Publishable Key ID for browser checkout (Optional: if empty, backend provides keyId or falls back to COD)
VITE_RAZORPAY_KEY_ID=rzp_test_yourKeyHere
