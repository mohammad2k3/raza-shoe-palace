# ====================================================
# RAZA SHOE PALACE — BACKEND ENVIRONMENT CONFIGURATION
# ====================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas production or local)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/raza_shoe_palace?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/raza_shoe_palace

# JWT Secret & Cookie Configuration (Use a 32+ character strong secret in production)
JWT_SECRET=raza_shoe_palace_ultra_secure_jwt_secret_key_2026_xyz987
JWT_EXPIRE=30d

# Cloudinary Credentials (Optional - Local disk upload works out-of-the-box if omitted)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Test / Live Mode Credentials
RAZORPAY_KEY_ID=rzp_test_yourKeyHere
RAZORPAY_KEY_SECRET=yourSecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere

# Initial Admin Seed Credentials
ADMIN_NAME=Raza Admin
ADMIN_EMAIL=admin@razashoepalace.com
ADMIN_PASSWORD=Admin@Raza2026!
ADMIN_PHONE=+919876543210
